# =========================
# AIGC Checker Engine
# .env 示例配置
# =========================

# ---------------------------------
# 1. 基础运行配置
# ---------------------------------

# 检测与表达扰动提供方：ollama / bailian。服务器配置生效，前端不能切换提供方。
DETECTION_PROVIDER=ollama
# 兼容旧请求的默认入参；统一部署入口会同步为 DETECTION_PROVIDER。
API_SOURCE=ollama

# 百炼模式使用以下配置；BASE_URL 必须与 API Key 的地域匹配。
# 北京旧域名仍可用；也可填写控制台提供的业务空间专属兼容 API 地址。
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
BAILIAN_REWRITE_MODEL=qwen-plus
BAILIAN_TIMEOUT=120
BAILIAN_MAX_CONCURRENCY=10
BAILIAN_JSON_MAX_TOKENS=512

# 业务访问 Token：按 Pro 权限处理；/tasks 及任务查询接口无需 Token。
# 未配置时服务端默认使用 aigcchecker；生产环境建议替换为高熵随机值。
API_TOKEN=aigcchecker

# Demo / 测试页任务轨迹（SQLite，仅记录脱敏运行元数据）。
TASK_LOG_DB_PATH=data/task_logs.db
TASK_LOG_MAX_RECORDS=200


# ---------------------------------
# 2. 套餐 token 配置
# ---------------------------------

# 普通版 token，多个用英文逗号分隔。
# 这些 token 只能调用 /api/scan，不支持 /api/reduce，也不会触发远程复核。
FREE_API_TOKENS=free_token_example_1,free_token_example_2

# 会员版 token，多个用英文逗号分隔。
# 这些 token 可以调用 /api/scan 和 /api/reduce，并允许低置信度远程复核。
PRO_API_TOKENS=pro_token_example_1,pro_token_example_2

# 不同套餐最大可检测字符数。
FREE_MAX_CHARS=3000
PRO_MAX_CHARS=12000


# ---------------------------------
# 3. Ollama 配置
# ---------------------------------

# 你的 Ollama 服务地址。
OLLAMA_BASE_URL=http://218.4.33.190:26316

# Optional standalone Docker Ollama on the same host:
# OLLAMA_BASE_URL=http://aigc-ollama:11434
# OLLAMA_DOCKER_NETWORK=aigc-models
# disploy.sh reconnects the API container to this network after updates.
# Leave empty when Ollama is remote or the API runs directly on the host.
OLLAMA_DOCKER_NETWORK=

# scan 主检测模型（固定走 Ollama 时使用）。
OLLAMA_MODEL=qwen3.5:9b

# Ollama 请求超时，单位秒。
OLLAMA_TIMEOUT=120

# 是否显式关闭 thinking / reasoning 输出。
# Qwen 等思考模型建议保持 true，避免只返回 thinking 而没有最终 response。
OLLAMA_DISABLE_THINKING=true

# Ollama JSON 判别参数。
OLLAMA_JSON_NUM_CTX=1536
# Runtime enforces at least 256 tokens; length-truncated JSON retries with a larger budget.
OLLAMA_JSON_NUM_PREDICT=256

# 每篇文档按分块数动态并发，最多 10 块；模型请求容量跨任务共享，硬上限也是 10。
# 需要降低负载时可设置为 1～9；Ollama 服务端的推理并行数需单独配置。
OLLAMA_MAX_CONCURRENCY=10
SCAN_CHUNK_CONCURRENCY=10

# CPU-only instances can set this to 4; zero leaves the runtime default.
OLLAMA_NUM_THREAD=0

# Optional original-text likelihood service (separate CPU GGUF service).
# Measured PPL is explanatory only until a labeled dataset supplies calibration.
PROBABILITY_ENABLED=false
PROBABILITY_BASE_URL=http://127.0.0.1:8091
PROBABILITY_TIMEOUT=600

# reduce Step2：Ollama 本地 Qwen 扰动参数。
OLLAMA_REWRITE_MODEL=qwen3.5:9b
OLLAMA_REWRITE_NUM_CTX=4096
OLLAMA_REWRITE_NUM_PREDICT=1024


# ---------------------------------
# 4. reduce rewrite 固定提供方链路
# ---------------------------------

# reduce rewrite Step1：Azure GPT-4o 深度语义重写
# 注意：这里传的是 Azure deployment name，不是公共模型 ID。
AZURE_API_KEY=
# 默认与 wd-ranktool 的微软官方直连相同，使用 /openai/v1/chat/completions。
# AZURE_ENDPOINT 支持资源根地址或截至 /openai/v1/ 的地址。
AZURE_API_MODE=v1
AZURE_ENDPOINT=
AZURE_DEPLOYMENT=gpt-4o
AZURE_REWRITE_DEPLOYMENT=gpt-4o
# 仅 AZURE_API_MODE=legacy 使用，v1 不发送 api-version。
AZURE_API_VERSION=2025-04-01-preview
AZURE_TIMEOUT=600
AZURE_CONNECT_TIMEOUT=10

# reduce rewrite Step1 的远端兜底：OpenRouter qwen/qwen-plus
# 注意：这里传的是 OpenRouter model ID。
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_MODEL=qwen/qwen-plus
OPENROUTER_REWRITE_MODEL=qwen/qwen-plus
OPENROUTER_EXCLUDE_REASONING=true

# self = 直连 OpenRouter
# proxy = 通过内部代理服务转发
OPENROUTER_SEND_MODE=self

# 如果 OPENROUTER_SEND_MODE=proxy，再填写下面两个。
PROXY_BASE_URL=http://119.28.110.115:5000
PROXY_TOKEN=replace_with_proxy_token


# ---------------------------------
# 5. 会员版远程复核配置（可选）
# ---------------------------------

# 会员版在低置信度、边界分数、保守文体时，会尝试远程高级模型复核。
# 复核固定为 Azure，不再使用 OpenRouter；此项仅保留兼容。
PRO_REVIEW_SOURCE=azure

# 远程复核模型。
# Azure deployment name。留空时沿用 AZURE_DEPLOYMENT。
AZURE_REVIEW_DEPLOYMENT=
# 支持的模型可设置 none/low/medium/high/xhigh/max；留空沿用模型默认。
# v1 不传自定义 temperature，避免推理模型参数冲突。
AZURE_REVIEW_REASONING_EFFORT=


# ---------------------------------
# 6. Token 生成建议
# ---------------------------------

# 推荐不要手写短 token。
# 可以本地生成高熵随机 token，例如：
#
# openssl rand -hex 24
#
# 会得到类似：
# 9f2a7d6dcb7f0fe4d6f14e63381f5d9c8e6d0a2f0e55d7c1
#
# 你可以一次生成多个，分别放进：
# FREE_API_TOKENS=tokenA,tokenB
# PRO_API_TOKENS=tokenC,tokenD
#
# 调用方使用方式：
# Authorization: Bearer <对应 token>
