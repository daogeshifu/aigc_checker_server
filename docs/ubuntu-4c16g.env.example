# Ubuntu 4 核 / 16GiB：检测 API 与 Ollama 均运行在同机 Docker 中。
# 使用前替换全部 REPLACE_WITH_*；这里没有真实密钥。
# Ollama 容器：aigc-ollama；共享网络：aigc-models；模型：qwen3:4b。

# 基础运行与任务记录
API_SOURCE=ollama
API_TOKEN=REPLACE_WITH_ADMIN_TOKEN
TASK_LOG_DB_PATH=/app/data/task_logs.db
TASK_LOG_MAX_RECORDS=200

# 套餐 Token：分别填写随机 Token，多个值用英文逗号分隔。
FREE_API_TOKENS=REPLACE_WITH_FREE_TOKEN
PRO_API_TOKENS=REPLACE_WITH_PRO_TOKEN
FREE_MAX_CHARS=3000
PRO_MAX_CHARS=12000

# 同机 Ollama：API 容器通过共享网络连接模型容器。
OLLAMA_BASE_URL=http://aigc-ollama:11434
OLLAMA_DOCKER_NETWORK=aigc-models
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=600
OLLAMA_DISABLE_THINKING=true
OLLAMA_NUM_THREAD=3
OLLAMA_MAX_CONCURRENCY=1
SCAN_CHUNK_CONCURRENCY=1
OLLAMA_JSON_NUM_CTX=2048
OLLAMA_JSON_NUM_PREDICT=256

# reduce 第二步：本地扰动使用已拉取的相同模型。
OLLAMA_REWRITE_MODEL=qwen3:4b
OLLAMA_REWRITE_NUM_CTX=4096
OLLAMA_REWRITE_NUM_PREDICT=1024

# 原文概率评分服务尚未部署：保持关闭。
PROBABILITY_ENABLED=false
PROBABILITY_BASE_URL=http://aigc-cpu-scorer:8091
PROBABILITY_TIMEOUT=600

# reduce 第一步：Azure 优先，OpenRouter 兜底。
# 下列部署名按原配置保留，必须与 Azure 控制台中的实际部署名一致。
AZURE_API_KEY=REPLACE_WITH_AZURE_API_KEY
AZURE_ENDPOINT=https://suzhou-gpt5.cognitiveservices.azure.com/
AZURE_DEPLOYMENT=gpt-5.2
AZURE_REWRITE_DEPLOYMENT=gpt-5.2
# 供当前 AsyncAzureOpenAI 日期版客户端使用；以资源支持的版本为准。
# GPT-5.2 的 2025-12-11 是模型快照日期，不用于推导 API 版本。
AZURE_API_VERSION=2025-04-01-preview

OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
OPENROUTER_MODEL=qwen/qwen-plus
OPENROUTER_REWRITE_MODEL=qwen/qwen-plus
OPENROUTER_EXCLUDE_REASONING=true
OPENROUTER_SEND_MODE=self

# 直连模式不使用代理；只有切换为 proxy 时才需要填写。
PROXY_BASE_URL=
PROXY_TOKEN=

# 保留会员版可选远程复核，普通版不会触发。
REMOTE_REVIEW_ENABLED=true
PRO_REVIEW_SOURCE=openrouter
PRO_REVIEW_MODEL=qwen/qwen-plus
