# Unified local deployment: copied to deploy.env on first up/download/config.
# Business credentials and plan tokens remain in .env. Never source either file.
# DETECTION_PROVIDER is read from .env: bailian skips/stops the Ollama container.
# auto uses the Docker daemon's resources, not the CLI host's resources.
OLLAMA_DEPLOY_MODEL=qwen3:4b
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_DEPLOY_CPUS=auto
OLLAMA_DEPLOY_MEMORY_GB=auto

# true: add scorer; false: scorer stopped after API update.
# Ollama is only needed when .env has DETECTION_PROVIDER=ollama.
SCORER_ENABLED=true
SCORER_CPUS=auto
SCORER_MEMORY_GB=auto
SCORER_THREADS=auto
SCORER_CONTEXT_TOKENS=1024
SCORER_STRIDE_TOKENS=512
SCORER_MAX_TOKENS=16000
SCORER_WAIT_SECONDS=600
MODEL_SOURCE=modelscope
